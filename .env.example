# ───────── M-Pesa (Safaricom Daraja) ─────────
MPESA_ENV=sandbox                         # sandbox | live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_TOKEN=long-random-string   # appended to callback URLs as ?token=

# ───────── Bank (statement API for fetching payments) ─────────
# Fill these from your bank or aggregator (Equity Jenga, KCB Buni, Co-op, Pesalink, Stanbic, etc.).
BANK_API_BASE_URL=https://api.yourbank.example
BANK_API_KEY=
BANK_API_SECRET=
BANK_ACCOUNT_NUMBER=
BANK_API_TX_PATH=/v1/accounts/{account}/transactions   # {account} is replaced with BANK_ACCOUNT_NUMBER
BANK_API_AUTH=bearer                                    # bearer | x-api-key
BANK_WEBHOOK_SECRET=                                    # HMAC secret if the bank pushes payments to /api/bank/webhook

# ───────── File storage (photos/PDFs, optional; photos currently live in the database) ─────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
BLOB_READ_WRITE_TOKEN=                    # if you use Vercel Blob instead

# ───────── Monitoring (optional) ─────────
SENTRY_DSN=
